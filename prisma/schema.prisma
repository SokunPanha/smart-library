generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LIBRARIAN
  STAFF
}

enum MemberType {
  STUDENT
  TEACHER
  PUBLIC
  RESEARCHER
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nameEn    String
  nameKh    String?
  role      Role     @default(LIBRARIAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id              String   @id @default(cuid())
  isbn            String?  @unique
  titleEn         String
  titleKh         String?
  author          String?
  publisher       String?
  publishYear     Int?
  category        String?
  deweyCode       String?
  coverImage      String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  tags            String[]
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shelfId         String?
  shelf           Shelf?       @relation(fields: [shelfId], references: [id])
  loans           Loan[]
  reservations    Reservation[]
  visitorLogBooks VisitorLogBook[]
}

model Member {
  id        String     @id @default(cuid())
  memberId  String     @unique
  nameEn    String?
  nameKh    String?
  email     String?
  phone     String?
  photo     String?
  type      MemberType @default(PUBLIC)
  expiresAt DateTime?
  classId   String?
  createdBy String?
  updatedBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  loans        Loan[]
  reservations Reservation[]
  visitorLogs  VisitorLog[]
  class        Class?     @relation(fields: [classId], references: [id])
}

model Class {
  id        String   @id @default(cuid())
  name      String   @unique
  grade     String?
  createdAt DateTime @default(now())
  members   Member[]
}

model Loan {
  id          String     @id @default(cuid())
  bookId      String
  memberId    String
  borrowedAt  DateTime   @default(now())
  dueAt       DateTime
  returnedAt  DateTime?
  status      LoanStatus @default(ACTIVE)
  fineAmount    Float      @default(0)
  finePaid      Boolean    @default(false)
  fineWaived    Boolean    @default(false)
  finePaidAt    DateTime?
  fineNote      String?
  renewalCount  Int        @default(0)
  notes         String?
  checkedOutBy String?
  closedBy    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  book        Book       @relation(fields: [bookId], references: [id])
  member      Member     @relation(fields: [memberId], references: [id])
}

model Reservation {
  id          String            @id @default(cuid())
  bookId      String
  memberId    String
  status      ReservationStatus @default(PENDING)
  reservedAt  DateTime          @default(now())
  fulfilledAt DateTime?
  cancelledAt DateTime?
  createdBy   String?
  book        Book              @relation(fields: [bookId], references: [id])
  member      Member            @relation(fields: [memberId], references: [id])

  @@index([bookId, status])
  @@index([memberId, status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Shelf {
  id        String   @id @default(cuid())
  code      String   @unique  // e.g. "A-F-2-3" or "A-2-3"
  cabinet   String            // Cabinet identifier: "A", "B", "C"
  side      String?           // Optional face: "F" (front) or "R" (rear)
  shelfNo   Int               // Shelf row from top: 1, 2, 3
  sectionNo Int               // Section slot from left: 1, 2, 3
  zone      String?           // Subject zone: "Science", "History"
  label     String?           // Optional description
  createdAt DateTime @default(now())
  books     Book[]
}

model LibraryMap {
  id        String   @id @default(cuid())
  rows      Int      @default(8)
  cols      Int      @default(12)
  cells     Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model VisitorLog {
  id         String           @id @default(cuid())
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id])
  purpose    String
  note       String?
  arrivedAt  DateTime         @default(now())
  leftAt     DateTime?
  recordedBy String
  books      VisitorLogBook[]

  @@index([arrivedAt(sort: Desc)])
  @@index([memberId])
}

model VisitorLogBook {
  id           String     @id @default(cuid())
  visitorLogId String
  visitorLog   VisitorLog @relation(fields: [visitorLogId], references: [id], onDelete: Cascade)
  bookId       String
  book         Book       @relation(fields: [bookId], references: [id])
  addedAt      DateTime   @default(now())

  @@unique([visitorLogId, bookId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userEmail   String
  userName    String
  action      String
  description String
  entityId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
